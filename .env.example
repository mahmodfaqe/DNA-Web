# Copy to .env and fill in real values before the first `docker compose up`.
#
#   cp .env.example .env
#   docker compose run --rm --no-deps --entrypoint "" frontend php artisan key:generate --show
#
# Every value below is required; compose refuses to start without them rather
# than silently booting with a default password.

APP_NAME="DNA Analytics"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# Paste the output of `php artisan key:generate --show`, including the base64: prefix.
APP_KEY=

# Default interface language: ku (Kurdish), ar (Arabic) or en (English).
APP_LOCALE=ku

MYSQL_DATABASE=dna_db
MYSQL_USER=dna_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Analysis limits
MAX_FILE_SIZE=10485760
MAX_UPLOAD_KB=10240
MAX_RECORDS=500
ALIGN_MAX_BP=3000
RATE_LIMIT_PER_MINUTE=30

# Restrict to the public origin once deployed, e.g. https://dna.uor.edu.krd
CORS_ORIGINS=http://localhost:8080

LOG_LEVEL=INFO
