# Local development without Docker.
# For the Docker setup, use the .env.example in the project root instead.

APP_NAME="DNA Analytics"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# php artisan key:generate
APP_KEY=base64:grWF7WjVOSiQiHSgrTZFfT5T9IDv86CQ5RZCeTNAQOA=

# ku (Kurdish), ar (Arabic) or en (English)
APP_LOCALE=ku
APP_FALLBACK_LOCALE=en

# Base URL of the analysis service, without a trailing path.
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=120
MAX_UPLOAD_KB=10240

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dna_db
DB_USERNAME=dna_user
DB_PASSWORD=dnapassword

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
